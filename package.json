{
  "name": "sri-lanka-hotel-rate-sheet-hunter",
  "version": "3.0.0",
  "description": "Sri Lanka Travel Agency Hotel Rate Sheet Procurement & Management Automation",
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env index.js",
    "search:5star": "node --env-file=.env index.js --category=5-star",
    "search:4star": "node --env-file=.env index.js --category=4-star",
    "search:3star": "node --env-file=.env index.js --category=3-star",
    "dry-run": "node --env-file=.env index.js --dry-run",
    "sync:inbox": "node --env-file=.env index.js --sync-inbox",
    "dashboard": "node --env-file=.env dashboard.js",
    "dev": "node --env-file=.env dashboard.js",
    "postinstall": "node scripts/patch-wwebjs.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "discord.js": "^14.18.0",
    "express": "^5.2.1",
    "imapflow": "^2.1.2",
    "mailparser": "^3.9.32",
    "node-cron": "^3.0.3",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.19.1",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.26.1",
    "xlsx": "^0.18.5"
  }
}
