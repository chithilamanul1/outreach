# ── Required APIs ─────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── LLM Model (Classification & Parsing) ───────────────────────
OPENROUTER_MODEL=anthropic/claude-3-haiku

# ── Travel Agency Profile (Appears on B2B Rate Inquiries) ──────
TRAVEL_AGENCY_NAME="Ocean Tours Sri Lanka"
TRAVEL_AGENCY_CONTACT="Inbound Reservations & Contracting Desk"
TRAVEL_AGENCY_PHONE="+94 77 123 4567"

# ═══════════════════════════════════════════════════════════════
# ── Custom Hosting Mailbox (cPanel, Webmail, Titan, etc.) ──────
# ═══════════════════════════════════════════════════════════════
# Use your domain email (e.g. info@ocean-tours.lk) to send requests
# and monitor inbox replies:
SMTP_HOST=mail.ocean-tours.lk
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@ocean-tours.lk
SMTP_PASS=your_mailbox_password_here

IMAP_HOST=mail.ocean-tours.lk
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=info@ocean-tours.lk
IMAP_PASS=your_mailbox_password_here

# ═══════════════════════════════════════════════════════════════
# ── Instant Rate Sheet Delivery to WhatsApp ───────────────────
# ═══════════════════════════════════════════════════════════════
# When hotels email back their rate sheets (PDF / Excel), the system
# downloads them and immediately forwards the documents directly to:
ADMIN_WHATSAPP_NUMBER=947xxxxxxxx

# ── Storage Configuration ─────────────────────────────────────
# Destination directory for categorized rate sheets
# Structure created: rate_sheets/{3_star|4_star|5_star}/{Hotel_Name}/
RATE_SHEETS_DIR=rate_sheets
