# ── Required API Keys ──────────────────────────────────────────
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── LLM Model (OpenRouter / Gemini / Claude) ────────────────────
OPENROUTER_MODEL=google/gemini-2.5-flash

# ── Discord Real-Time Sales Alerts ─────────────────────────────
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
DISCORD_HOT_LEADS_WEBHOOK=https://discord.com/api/webhooks/...

# ── Seranix Digital Agency Profile ──────────────────────────────
AGENCY_NAME="Seranix Digital"
AGENCY_PHONE="+94760602638"
AGENCY_WEBSITE="https://seranix.digital"

# ── WhatsApp Outbound & Inbound Sales Agent ────────────────────
# Auto-send pitches via WhatsApp (true / false)
WHATSAPP_AUTO_SEND=true
# Sender bot account phone number (e.g. 94760602638):
BOT_WHATSAPP_NUMBER=94760602638
# Founder / Closer phone number to receive instant HOT lead alerts:
ADMIN_WHATSAPP_NUMBER=94711770186

# ── Email Outreach SMTP (Hostinger / cPanel / Gmail) ───────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hello@seranix.digital
SMTP_PASS=your_mailbox_password_here

# (Optional IMAP for reply monitoring)
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=hello@seranix.digital
IMAP_PASS=your_mailbox_password_here
