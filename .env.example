# ── Seranex Lanka Solutions Agency Profile ─────────────────────
AGENCY_NAME="Seranex Lanka Solutions"
AGENCY_PHONE="07228382638"
AGENCY_WEBSITE="https://seranex.lk"

# ── WhatsApp Outbound & Inbound Sales Agent ────────────────────
WHATSAPP_AUTO_SEND=true
BOT_WHATSAPP_NUMBER=94760602638
ADMIN_WHATSAPP_NUMBER=947228382638

# ═══════════════════════════════════════════════════════════════
# ── Email Outreach Options (Resend API or SMTP) ────────────────
# ═══════════════════════════════════════════════════════════════

# OPTION 1: Resend API (Recommended for info@seranex.lk - Fastest & Best Deliverability)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=info@seranex.lk

# OPTION 2: Resend SMTP
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=resend
# SMTP_PASS=re_xxxxxxxxxxxxxxxxxxxx
